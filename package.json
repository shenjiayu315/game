{
  "name": "spirit-tree-dynamic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm validate:content && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
